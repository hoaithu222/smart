# Thi nghiem TH1: lenh sai va gioi han.
/cai bai1_APDU.Applet1
/cai bai1_APDU.Applet3
/cai bai1_APDU.Applet4

## Chon AID khong co tren the
00 A4 04 00 06 11 22 33 44 55 99 => 6A 82

## Applet1: lenh case 1 (4 byte) van duoc tra du lieu; applet khong kiem CLA
/select bai1_APDU.Applet1
00 00 00 00 => "Xin chao, KMA" 90 00
80 00 00 00 => "Xin chao, KMA" 90 00

## Applet3: P1 la so khong dau
/select bai1_APDU.Applet3
00 01 00 00 02 => 00 00 90 00
# 80h = 128 (khong phai -128): 128 x 128 = 16384 = 4000h
00 01 80 00 02 => 40 00 90 00

## Applet4: do dai du lieu
/select bai1_APDU.Applet4
00 01 00 00 => 67 00
# 129 byte > 128
00 01 00 00 81 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 => 67 00
# 128 byte vua gioi han nhung khong co dau |
00 01 00 00 80 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 61 => 6A 80
