# Bai thuc hanh 1 - goi bai1_APDU.  Dong lenh co the chep vao Debug Shell JCIDE (/send ...).
# Sau "=>" la ket qua mong doi (du lieu + SW). Chuoi trong ngoac kep la ASCII.

## Bai 1: in "Xin chao, KMA"
/cai bai1_APDU.Applet1
/select bai1_APDU.Applet1
00 00 00 00 0D => "Xin chao, KMA" 90 00
00 05 00 00 => 6D 00

## Bai 2: ho ten, ngay sinh, ca hai
/cai bai1_APDU.Applet2
/select bai1_APDU.Applet2
00 01 00 00 00 => "Nguyen Van A" 90 00
00 02 00 00 00 => "01/01/2004" 90 00
00 03 00 00 00 => "Nguyen Van A - 01/01/2004" 90 00
00 04 00 00 => 6D 00

## Bai 3: dien tich hinh vuong, hinh chu nhat
/cai bai1_APDU.Applet3
/select bai1_APDU.Applet3
# vuong canh 5 = 25
00 01 05 00 02 => 00 19 90 00
# chu nhat 12 x 5 = 60
00 02 0C 05 02 => 00 3C 90 00
# lon nhat 255 x 255 = 65025 (khong dau)
00 02 FF FF 02 => FE 01 90 00
00 01 FF 00 02 => FE 01 90 00
00 03 01 01 => 6D 00

## Bai 4: nhap "CT070254|Nguyen Van A|01/01/2004|Ha Noi" roi in
/cai bai1_APDU.Applet4
/select bai1_APDU.Applet4
00 02 00 00 00 => 69 85
00 01 00 00 27 43 54 30 37 30 32 35 34 7C 4E 67 75 79 65 6E 20 56 61 6E 20 41 7C 30 31 2F 30 31 2F 32 30 30 34 7C 48 61 20 4E 6F 69 => 90 00
# ca chuoi
00 02 00 00 00 => "CT070254|Nguyen Van A|01/01/2004|Ha Noi" 90 00
# tung truong
00 02 01 00 00 => "CT070254" 90 00
00 02 02 00 00 => "Nguyen Van A" 90 00
00 02 03 00 00 => "01/01/2004" 90 00
00 02 04 00 00 => "Ha Noi" 90 00
00 02 05 00 00 => 6A 86
# sai dinh dang: chi co 3 truong
00 01 00 00 05 61 7C 62 7C 63 => 6A 80
# co truong rong
00 01 00 00 06 61 7C 7C 63 7C 64 => 6A 80
# du lieu cu khong bi hong
00 02 01 00 00 => "CT070254" 90 00
# rut the, cam lai: du lieu con nguyen (EEPROM)
/reset
/select bai1_APDU.Applet4
00 02 04 00 00 => "Ha Noi" 90 00

## May tinh bo tui
/cai bai1_APDU.Calculator
/select bai1_APDU.Calculator
00 01 05 03 02 => 00 08 90 00
00 01 FF FF 02 => 01 FE 90 00
# 3 - 5 = -2
00 02 03 05 02 => FF FE 90 00
# 12 x 12 = 144
00 03 0C 0C 02 => 00 90 90 00
00 03 FF FF 02 => FE 01 90 00
# 17 : 5 = 3 du 2
00 04 11 05 02 => 03 02 90 00
00 04 05 00 02 => 6A 86
00 09 00 00 => 6D 00
